{
  "name": "@robusta/pyramids-design-system",
  "type": "module",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sketch.css": "./sketch.css",
    "./colors_and_type.css": "./colors_and_type.css",
    "./fonts.css": "./fonts.css",
    "./assets/crystal-tux.png": "./assets/crystal-tux.png",
    "./assets/niktux-furious-at-computer.webp": "./assets/niktux-furious-at-computer.webp",
    "./assets/niktux-pack-ice.webp": "./assets/niktux-pack-ice.webp",
    "./assets/niktux-presentation.webp": "./assets/niktux-presentation.webp",
    "./assets/niktux-thinks.webp": "./assets/niktux-thinks.webp",
    "./assets/niktux-throw-money.webp": "./assets/niktux-throw-money.webp",
    "./assets/niktux-working-hard.webp": "./assets/niktux-working-hard.webp",
    "./assets/robusta-build-wordmark.svg": "./assets/robusta-build-wordmark.svg"
  },
  "files": [
    "dist",
    "*.css",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test \".test-build/**/*.spec.js\"",
    "watch": "tsc -p . --watch"
  },
  "peerDependencies": {
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "8.57.0",
    "react": "^19.1.1",
    "typescript": "^5"
  }
}
