{
  "//": "Compiles the site's routing, content and seo seams to plain ESM under .routing-dist, for the plain-Node scripts: emit-v1-map.mjs, copy-article-images.mjs, prerender-pages.mjs, check-route-table.mjs, emit-site-files.mjs and check-seo.mjs.",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "outDir": ".routing-dist",
    "rootDir": "src",
    "declaration": false,
    "skipLibCheck": true,
    "strict": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/routing/scheme.ts",
    "src/routing/v1-url-map.ts",
    "src/routing/content-urls.ts",
    "src/routing/counterparts.ts",
    "src/routing/listed-articles.ts",
    "src/routing/url-scheme",
    "src/content",
    "src/seo"
  ]
}
