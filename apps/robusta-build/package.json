{
  "name": "@robusta/robusta-build",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn emit:redirects && next dev --turbopack",
    "build": "yarn emit:redirects && next build && node scripts/check-route-table.mjs",
    "emit:redirects": "tsc -p tsconfig.routing.json && node scripts/emit-redirects.mjs",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@robusta/pyramids-content": "workspace:*",
    "@robusta/pyramids-design-system": "workspace:*",
    "@robusta/pyramids-routing": "workspace:*",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
