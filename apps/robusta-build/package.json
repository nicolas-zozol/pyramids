{
  "name": "@robusta/robusta-build",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn emit:v1-map && yarn copy:assets && vite dev",
    "build": "yarn check:types && yarn check:source && yarn check:translations && yarn emit:v1-map && yarn copy:assets && vite build && node scripts/check-route-table.mjs && node scripts/emit-site-files.mjs && node scripts/check-seo.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "emit:v1-map": "node scripts/emit-v1-map.mjs",
    "copy:assets": "node scripts/copy-article-images.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@robusta/pyramids-design-system": "workspace:*",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@tanstack/start-static-server-functions": "1.167.40",
    "gray-matter": "^4.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "slugify": "1.6.6",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.12.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "8.57.0",
    "eslint-plugin-react": "^7.35.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
